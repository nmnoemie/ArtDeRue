{% extends 'base.html.twig' %}

{% block title %}Nouvel Artiste{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white">
                        <h3 class="mb-0">Ajouter un nouvel artiste</h3>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                            
                            {{ form_errors(form) }}

                            <div class="row">
                                {# Pseudo #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.pseudo, 'Pseudo', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.pseudo, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Picasso'}}) }}
                                    {{ form_errors(form.pseudo) }}
                                </div>

                                {# Nom #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.nom) }}
                                </div>

                                {# Nationalité #}
                                <div class="col-md-12 mb-3">
                                    {{ form_label(form.nationalite, 'Nationalité', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.nationalite, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.nationalite) }}
                                </div>

                                {# Bio #}
                                <div class="col-md-12 mb-3">
                                    {{ form_label(form.bio, 'Biographie', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.bio, {'attr': {'class': 'form-control', 'rows': '5', 'placeholder': 'Quelques mots sur l\'artiste...'}}) }}
                                    {{ form_errors(form.bio) }}
                                </div>

                                {# Oeuvres associées (Cases à cocher) #}
                                <div class="col-md-12 mb-3">
                                    {{ form_label(form.Oeuvres, 'Œuvres associées', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    
                                    {# On entoure les cases à cocher d'une boîte pour faire propre #}
                                    <div class="border rounded p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                                        {{ form_widget(form.Oeuvres) }}
                                    </div>
                                    
                                    {{ form_errors(form.Oeuvres) }}
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a href="{{ path('app_artistes_index') }}" class="btn btn-secondary me-md-2">Annuler</a>
                                <button type="submit" class="btn btn-primary">Enregistrer l'artiste</button>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}