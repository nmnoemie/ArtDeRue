{% extends 'base.html.twig' %}

{% block title %}Artistes{% endblock %}

{% block body %}
    <h1>Artistes</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ artiste.id }}</td>
            </tr>
            <tr>
                <th>Pseudo</th>
                <td>{{ artiste.pseudo }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ artiste.nom }}</td>
            </tr>
            <tr>
                <th>Bio</th>
                <td>{{ artiste.bio }}</td>
            </tr>
            <tr>
                <th>Nationalite</th>
                <td>{{ artiste.nationalite }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_artistes_index') }}">back to list</a>

    <a href="{{ path('app_artistes_edit', {'id': artiste.id}) }}">edit</a>

    {{ include('artistes/_delete_form.html.twig') }}
{% endblock %}
