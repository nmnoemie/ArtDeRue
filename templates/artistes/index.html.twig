{% extends 'base.html.twig' %}

{% block title %}Artistes index{% endblock %}

{% block body %}
    <h1>Artistes index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Pseudo</th>
                <th>Nom</th>
                <th>Bio</th>
                <th>Nationalite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudo }}</td>
                <td>{{ artiste.nom }}</td>
                <td>{{ artiste.bio }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td>
                    <a href="{{ path('app_artistes_show', {'id': artiste.id}) }}">show</a>
                    <a href="{{ path('app_artistes_edit', {'id': artiste.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_artistes_new') }}">Create new</a>
{% endblock %}
