{% extends 'base.html.twig' %}

{% block title %}Oeuvre{% endblock %}

{% block body %}
    <h1>Oeuvre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>

                <td>{{ oeuvre.id }}</td>

            </tr>

            <tr>

                <th>Titre</th>

                <td>{{ oeuvre.titre }}</td>

            </tr>

            <tr>
                <th>Date</th>

                <td>{{ oeuvre.date ? oeuvre.date|date('Y-m-d') : '' }}</td>
            </tr>


            <tr>

                <th>Description</th>

                <td>{{ oeuvre.description }}</td>

            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_oeuvres_index') }}">back to list</a>

    <a href="{{ path('app_oeuvres_edit', {'id': oeuvre.id}) }}">edit</a>

    {{ include('oeuvres/_delete_form.html.twig') }}
{% endblock %}
