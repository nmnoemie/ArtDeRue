{% extends 'base.html.twig' %}

{% block title %}Nouvelle Œuvre{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white">
                        <h3 class="mb-0">Créer une nouvelle œuvre</h3>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                            
                            {# Affichage des erreurs globales #}
                            {{ form_errors(form) }}

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    {{ form_label(form.titre, 'Titre de l\'œuvre', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: La Joconde'}}) }}
                                    {{ form_errors(form.titre) }}
                                </div>
                                
                                
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.date, 'Date de création', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.date) }}
                                </div>

                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.Lieux, 'Lieu', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.Lieux, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.Lieux) }}
                                    
                                    <div class="mt-2">
                                        {{ form_widget(form.nouveauLieu, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Ou créez un nouveau lieu'}}) }}
                                        {{ form_errors(form.nouveauLieu) }}
                                    </div>
                                </div>

                                <div class="col-md-12 mb-3">
                                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
                                    {{ form_errors(form.description) }}
                                </div>

                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.technique, 'Technique', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.technique, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.technique) }}
                                    
                                    <div class="mt-2">
                                        {{ form_widget(form.nouvelleTechnique, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Ou créez une nouvelle technique'}}) }}
                                        {{ form_errors(form.nouvelleTechnique) }}
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.Artistes, 'Artistes', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.Artistes, {'attr': {'class': 'form-select', 'size': '3'}}) }}
                                    {{ form_errors(form.Artistes) }}
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a href="{{ path('app_oeuvres_index') }}" class="btn btn-secondary me-md-2">Annuler</a>
                                <button type="submit" class="btn btn-primary">Enregistrer l'œuvre</button>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}