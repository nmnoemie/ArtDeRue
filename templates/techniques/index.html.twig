{% extends 'base.html.twig' %}

{% block title %}Techniques index{% endblock %}

{% block body %}
    <h1>Techniques index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Technique</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for technique in techniques %}
            <tr>
                <td>{{ technique.id }}</td>
                <td>{{ technique.technique }}</td>
                <td>
                    <a href="{{ path('app_techniques_show', {'id': technique.id}) }}">show</a>
                    <a href="{{ path('app_techniques_edit', {'id': technique.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_techniques_new') }}">Create new</a>
{% endblock %}
