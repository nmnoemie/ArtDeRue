{% extends 'base.html.twig' %}

{% block title %}Nouvelle Photo{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white">
                        <h3 class="mb-0">Ajouter une nouvelle photo</h3>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                            
                            {{ form_errors(form) }}

                            <div class="row">
                                {# Date #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.date, 'Date de la photo', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.date) }}
                                </div>

                                {# Image #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.imageFile, 'Choisir une image', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.imageFile) }}
                                </div>

                                {# Etat de l'oeuvre #}
                                <div class="col-md-12 mb-3">
                                    {{ form_label(form.etatOeuvre, 'État de l\'œuvre', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.etatOeuvre, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.etatOeuvre) }}
                                </div>

                                {# Commentaire #}
                                <div class="col-md-12 mb-3">
                                    {{ form_label(form.commentaire, 'Commentaire', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': '3'}}) }}
                                    {{ form_errors(form.commentaire) }}
                                </div>

                                <hr class="my-3">
                                <h5 class="mb-3">Œuvre</h5>

                                {# Oeuvre existante #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.oeuvre, 'Choisir une œuvre existante', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.oeuvre, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.oeuvre) }}
                                </div>

                                {# Nouvelle Oeuvre #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.nouvelleOeuvre, 'Ou ajouter une nouvelle œuvre', {'label_attr': {'class': 'form-label fw-bold text-muted'}}) }}
                                    {{ form_widget(form.nouvelleOeuvre, {'attr': {'class': 'form-control', 'placeholder': 'Titre de la nouvelle œuvre'}}) }}
                                    {{ form_errors(form.nouvelleOeuvre) }}
                                </div>

                                <hr class="my-3">
                                <h5 class="mb-3">Bénévole</h5>

                                {# Bénévole existant #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.benevole, 'Choisir un bénévole existant', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.benevole, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.benevole) }}
                                </div>

                                {# Nouveau Bénévole #}
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.nouveauBenevole, 'Ou ajouter un nouveau bénévole', {'label_attr': {'class': 'form-label fw-bold text-muted'}}) }}
                                    {{ form_widget(form.nouveauBenevole, {'attr': {'class': 'form-control', 'placeholder': 'Nom du nouveau bénévole'}}) }}
                                    {{ form_errors(form.nouveauBenevole) }}
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a href="{{ path('app_photos_index') }}" class="btn btn-secondary me-md-2">Annuler</a>
                                <button type="submit" class="btn btn-primary">Enregistrer la photo</button>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}